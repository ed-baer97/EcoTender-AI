POSTGRES_USER=ecotender
POSTGRES_PASSWORD=ecotender
POSTGRES_DB=ecotender
JWT_SECRET=change-me-in-production-use-long-random
# Fernet master for runtime API keys (admin cabinet). Falls back to JWT_SECRET if empty.
SECRET_ENCRYPTION_KEY=change-me-encryption-key-long-random
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# CatBoost = own decision model (artifact in ml/models)
# LLM = explanation only via external OpenAI-compatible API
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-terra
# OpenAI GPT-5.6 (актуально на 2026):
#   gpt-5.6-sol   — флагман
#   gpt-5.6-terra — баланс цена/качество (дефолт для explain)
#   gpt-5.6-luna  — дешёвый high-volume
#   DeepSeek:    LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
# Without LLM_API_KEY the engine uses template_fallback explanations.

VITE_API_BASE_URL=http://localhost:8000/api/v1

# goszakup.gov.kz OWS v3 — https://goszakup.gov.kz/ru/developer/ows_v3
# Token: Центр Электронных Финансов / Профиль участника → Выпуск токена
# Without token: GOSZAKUP_USE_PLAYWRIGHT=true → Playwright stub (public portal HTML)
# Without token and no Playwright: data/fixtures/goszakup_sample.json (offline demo)
GOSZAKUP_TOKEN=
GOSZAKUP_BASE_URL=https://ows.goszakup.gov.kz
GOSZAKUP_PAGE_LIMIT=50
GOSZAKUP_MAX_PAGES=3

# Playwright stub (no OWS token) — scrapes https://goszakup.gov.kz/ru/search/announce
GOSZAKUP_USE_PLAYWRIGHT=true
GOSZAKUP_PW_KEYWORD=экология
GOSZAKUP_PW_REGION_ONLY=mangystau
GOSZAKUP_PW_FILTER_KATO=470000000
GOSZAKUP_PW_BROWSE_RECENT=false
GOSZAKUP_PW_PRESETS=ecology,oil_spill,water_monitoring,dredging,reclamation
GOSZAKUP_PW_KEYWORDS=нефт,очистка,рекультивация,мониторинг,утилизация,загрязн
GOSZAKUP_PW_MAX_ITEMS=50
GOSZAKUP_PW_MAX_PAGES=5
GOSZAKUP_PW_FETCH_DETAIL=true
GOSZAKUP_PW_HEADLESS=true
GOSZAKUP_PW_FILTER_AMOUNT_FROM=1000000
GOSZAKUP_PW_FILTER_TRADE_TYPE=r
# GOSZAKUP_PW_OFFLINE=true  # only HTML fixtures in data/fixtures/html/

MINIO_RAW_BUCKET=ecotender-raw

GOSZAKUP_DAILY_ENABLED=true
GOSZAKUP_DAILY_SOURCE_CODE=KZ_GOSZAKUP_PLAYWRIGHT
GOSZAKUP_DAILY_HOUR=3
GOSZAKUP_DAILY_MINUTE=0
